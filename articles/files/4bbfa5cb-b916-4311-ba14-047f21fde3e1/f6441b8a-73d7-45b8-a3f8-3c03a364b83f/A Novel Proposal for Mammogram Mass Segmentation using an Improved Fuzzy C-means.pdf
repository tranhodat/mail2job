<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="XMP Core 6.0.0">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:crossmark="http://crossref.org/crossmark/1.0/"
            xmlns:prism="http://prismstandard.org/namespaces/basic/2.0/"
            xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/"
            xmlns:jav="http://www.niso.org/schemas/jav/1.0/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#"
            xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
            xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"
            xmlns:xmpTPg="http://ns.adobe.com/xap/1.0/t/pg/"
            xmlns:stDim="http://ns.adobe.com/xap/1.0/sType/Dimensions#"
            xmlns:sn="http://springernature.com/ns/xmpExtensions/2.0/"
            xmlns:author="http://springernature.com/ns/xmpExtensions/2.0/authorInfo/"
            xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
            xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
            xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#"
            xmlns:pdfaType="http://www.aiim.org/pdfa/ns/type#"
            xmlns:pdfaField="http://www.aiim.org/pdfa/ns/field#">
         <xmp:CreateDate>2024-07-03T15:14:07+05:30</xmp:CreateDate>
         <xmp:CreatorTool>Adobe Illustrator 26.5 (Windows)</xmp:CreatorTool>
         <xmp:ModifyDate>2024-07-03T15:14:07+05:30</xmp:ModifyDate>
         <xmp:MetadataDate>2024-07-03T15:14:07+05:30</xmp:MetadataDate>
         <pdf:Producer>Acrobat Distiller 10.1.8 (Windows); modified using iTextÂ® 5.3.5 Â©2000-2012 1T3XT BVBA (SPRINGER SBM; licensed version)</pdf:Producer>
         <pdf:Keywords>Stock market; Trading; Investment; Machine learning (ML); Prediction; LSTM; GRU; RMSE; MSE; MAE</pdf:Keywords>
         <pdf:Trapped>False</pdf:Trapped>
         <dc:format>application/postscript</dc:format>
         <dc:identifier>https://doi.org/10.1007/s42979-024-02916-z</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Springer Nature Singapore</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">SN Computer Science, https://doi.org/10.1007/s42979-024-02916-z</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Stock market</rdf:li>
               <rdf:li>Trading</rdf:li>
               <rdf:li>Investment</rdf:li>
               <rdf:li>Machine learning (ML)</rdf:li>
               <rdf:li>Prediction</rdf:li>
               <rdf:li>LSTM</rdf:li>
               <rdf:li>GRU</rdf:li>
               <rdf:li>RMSE</rdf:li>
               <rdf:li>MSE</rdf:li>
               <rdf:li>MAE</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A Novel Approach for Forecasting Price of Stock Market using Machine Learning Techniques</rdf:li>
            </rdf:Alt>
